{
  "name": "site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev",
    "preview": "rsbuild preview",
    "lint": "biome lint src",
    "lint:fix": "biome lint src --fix",
    "format": "biome format src --write",
    "check": "biome check src",
    "check:fix": "biome check src --fix",
    "biome:upgrade": "biome migrate --write",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "ci:lint": "biome ci src",
    "ci:compress": "zstd -T0 -vfk -16 --rsyncable dist/*.css dist/*.js dist/*.html && brotli -f -k -Z dist/*.css dist/*.js dist/*.html && gzip -fk -9 dist/*.css dist/*.js dist/*.html",
    "ci:typecheck": "tsc --noEmit",
    "update:packageManager": "corepack use pnpm@latest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-vega": "^8.0.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "vega-typings": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/adapter-rsbuild": "^0.11.10",
    "@rstest/core": "^0.11.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^20.11.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Safari versions",
      "last 2 Edge versions"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
