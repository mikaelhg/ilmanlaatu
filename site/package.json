{
  "name": "site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev",
    "preview": "rsbuild preview",
    "lint": "biome lint src",
    "lint:fix": "biome lint src --fix",
    "format": "biome format src --write",
    "check": "biome check src",
    "check:fix": "biome check src --fix",
    "biome:upgrade": "biome migrate --write",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "ci:lint": "biome ci src",
    "ci:compress": "zstd -T0 -vfk -16 --rsyncable dist/*.css dist/*.js dist/*.html && brotli -f -k -Z dist/*.css dist/*.js dist/*.html && gzip -fk -9 dist/*.css dist/*.js dist/*.html",
    "ci:typecheck": "tsc --noEmit",
    "update:packageManager": "corepack use pnpm@latest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-vega": "^8.0.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "vega-typings": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@rsbuild/core": "^2.2.4",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/adapter-rsbuild": "^0.11.12",
    "@rstest/core": "^0.11.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.1+sha512.3c14c15408d1489d350f8ed7f93361d26cc707054f6849a4eea3bb7407ff4fe4564b413a1c421a773a176ab1168a8df1c7d548f2cd0dc7d344f58c4e680a5b18",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Safari versions",
      "last 2 Edge versions"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
